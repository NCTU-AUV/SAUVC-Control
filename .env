# =============================================================================
# SAUVC 載具控制堆疊 —— 環境設定單一來源
# =============================================================================
# docker compose 會自動讀取本檔案。所有 ROS / DDS 設定只在這裡定義一次，
# 由 docker-compose.yml 注入容器、由 Makefile 帶入 exec 出來的 shell。
#
# 未來併入 super-repo 後，這份檔案會上移一層，由 super-repo 的 compose
# 以 --env-file 同時餵給本堆疊與 Autonomy 堆疊，確保兩邊必然一致。
# 在那之前，請手動保持本檔與 SAUVC-Simulation / SAUVC-JETSON 的設定同步。
# -----------------------------------------------------------------------------

# --- ROS 2 網路 -------------------------------------------------------------
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# 關閉 Fast DDS 的共享記憶體傳輸，只走 UDPv4。
#
# 這是正確性設定，不是效能調校，不要為了「SHM 比較快」把它拿掉：
# 本容器掛載了 host 的 /dev（因為要存取 STM32 序列埠），連帶把 /dev/shm
# 也換成 host 的，與其他 SAUVC 容器（各自有獨立 /dev/shm）不一致。
# Fast DDS 預設會宣告 SHM locator，此時兩邊的 participant 會互相 match 到、
# 資料卻永遠走不通，而且不會有任何錯誤訊息 —— 表現出來就是「載具不動」。
# 實測：未設定時，容器內 `ros2 node list` 連自己啟動的節點都看不到。
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# --- 載具 -------------------------------------------------------------------
# 所有 topic 的 namespace 前綴。必須與 SAUVC-JETSON 的 decision.launch.py
# remap 目標一致（該處目前硬編碼為 /orca_auv）。
ORCA_NAMESPACE=orca_auv

# 推進器輸出後端：stm32（micro-ROS，原本的路徑）或 mavlink（ArduSub 飛控）。
# 預設 stm32，因為 mavlink 路徑還沒在實機驗證過。
ORCA_THRUSTER_BACKEND=stm32

# --- 裝置路徑 ---------------------------------------------------------------
# 裝置路徑放在這裡而不是 ROS 參數檔，因為 compose 也要用同一份值去掛裝置，
# 分兩個地方寫必然會漂移。控制參數則在
# rpi_ros2_ws/src/orca_bringup/config/ 底下。
#
# 一律優先用 /dev/serial/by-id/ 這種穩定路徑：STM32 從 RPi 換到 Jetson 之後，
# /dev/ttyUSB* 的編號不保證相同，插拔順序也會影響。查法：
#   ls -l /dev/serial/by-id/
ORCA_STM32_PORT=/dev/ttyUSB0

# ArduSub 飛控（MATEK H743）的 USB 序列埠。板子是 USB CDC，插上去通常是
# /dev/ttyACM0，但同時接了別的 CDC 裝置時編號會跑掉，一樣建議用 by-id：
#   ls -l /dev/serial/by-id/
ORCA_FLIGHT_CONTROLLER_PORT=/dev/ttyACM0

# --- 容器 / 映像 ------------------------------------------------------------
IMAGE_OWNER_NAME=dianyueguo
IMAGE_NAME=orca-auv-rpi-ros2-image
CONTAINER_NAME=orca-auv-rpi-ros2-container

# --- Bag 錄製 ---------------------------------------------------------------
# bag 落地在 host 的這個目錄（已加入 .gitignore）。
# 掛成獨立的 bind mount，避免寫進 workspace 或系統碟。
ORCA_BAG_DIR=./bags
